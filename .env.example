# Environment variables for this app.
#
# Secrets (API keys, tokens) are provided securely and injected into the
# environment at runtime — you do NOT paste them here. This file is just the
# manifest of which variables the app needs, so owners/devops know what to set.
#
# Rules:
#   - SECRET keys are read SERVER-SIDE only (Server Actions / server components)
#     via process.env.<NAME>. Never expose a secret to the browser.
#   - Never prefix a secret with NEXT_PUBLIC_ (that ships it to the client bundle).
#     NEXT_PUBLIC_ is ONLY for values meant to be public (e.g. the Supabase URL
#     and anon key).
#   - Add each variable below as NAME= with a short comment. Never commit a real value.

# --- Examples (uncomment / add the ones this app actually uses) ---
# FAL_KEY=                     # secret · fal.ai image generation (server-side only)
# OPENAI_API_KEY=             # secret · OpenAI (server-side only)
# NEXT_PUBLIC_SUPABASE_URL=   # public · Supabase project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # public · Supabase anon key

# --- Provided automatically by the platform (do NOT set these yourself) ---
# DATABASE_URL=              # secret · this app's database (pooled) — server-side only
# DATABASE_URL_UNPOOLED=     # secret · same database, direct connection, for `npm run db:push`
# IMAGINE_APP_TOKEN=         # secret · lets this app use platform file storage + email
# IMAGINE_SERVICES_URL=      # public · where those platform services live
# BETTER_AUTH_SECRET=        # secret · signs this app's session cookies (per-app, never shared)

# Reads your competitors' live ads out of the Meta Ad Library automatically, with
# artwork and the reach figures Meta publishes. Meta blocks direct reads from
# servers, so this key is what makes the AUTOMATIC route work. It is optional:
# without it, ads are imported from an Ad Library page the user opens in their own
# browser and pastes in, which needs no key. Name only, never a value.
SCRAPECREATORS_API_KEY=

# --- The owner's own Supabase project ---
# This app's data now lives in the owner's Supabase account rather than the
# platform-provided database. Paste the POOLED connection string (Project
# Settings → Database → Connection string → Transaction pooler, port 6543) with
# the real password substituted. The session-level endpoint on port 5432 is
# derived from it automatically, so only this one value is needed.
# Server-side only — never a NEXT_PUBLIC_ variable.
SUPABASE_DATABASE_URL=
# Optional override, only if the session-level host differs from the pooled one.
SUPABASE_DATABASE_URL_UNPOOLED=
